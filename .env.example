# Wrangler authentication (needed for CI; omit when using `wrangler login`).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Neon direct, non-pooled connection string. Never use production for tests.
DATABASE_URL=

# Destructive test suites require a separate disposable database and explicit acknowledgement.
TEST_DATABASE_URL=
CABINET_ALLOW_DB_RESET=0

# Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# One switch: worker-kimi, worker-deepseek, azure-kimi, or azure-deepseek.
CABINET_MODEL=worker-kimi

# Azure selections only. This stable URL stops before the deployment name;
# Cabinet appends the selected deployment and API path. The Azure key remains
# in AI Gateway BYOK.
# https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway-id>/azure-openai/<azure-resource>
AZURE_GATEWAY_BASE_URL=
CF_AIG_TOKEN=

# Optional local Hyperdrive override used by Wrangler dev. It can equal DATABASE_URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
