{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "postal",
  "compatibility_date": "2026-09-18",
  "keep_vars": true,
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [{ "binding": "INTENT_QUEUE", "queue": "postal-intent-queue" }],
    "consumers": [{ "queue": "postal-intent-queue" }]
  },
  "workflows": [{
    "binding": "PENDING_ACTION_WORKFLOW",
    "name": "postal-pending-action",
    "class_name": "PendingActionWorkflow"
  }],
  "hyperdrive": [{
    "binding": "HYPERDRIVE",
    "id": "REPLACE_WITH_YOUR_HYPERDRIVE_ID"
  }],
  "ratelimits": [{
    "name": "TELEGRAM_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 60, "period": 60 }
  }],
  "triggers": { "crons": ["0 14 * * *"] },
  "observability": { "enabled": true },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlueInventoryAgent"] }]
}
