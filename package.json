{
  "name": "cabinet",
  "version": "0.5.0",
  "description": "Telegram-first inventory and stock operations for small retailers",
  "license": "AGPL-3.0-only",
  "private": true,
  "author": {
    "name": "Repaera",
    "email": "hey@repaera.com",
    "url": "https://github.com/repaera"
  },
  "homepage": "https://github.com/repaera/kredlit-cabinet#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/repaera/kredlit-cabinet.git"
  },
  "bugs": {
    "url": "https://github.com/repaera/kredlit-cabinet/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist/cabinet/.dev.vars', { force: true })\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test:unit": "vitest run test/unit test/workflow",
    "test:runtime": "vitest run --config vitest.workers.config.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "audit:wiring": "tsx scripts/wiring-audit.ts",
    "telegram:set-webhook": "tsx scripts/set-webhook.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@flue/runtime": "2.0.8",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.7",
    "postgres": "^3.4.7",
    "valibot": "^1.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "@cloudflare/vitest-plugin": "1.2.3",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@flue/cli": "2.1.0",
    "@flue/vite": "2.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
